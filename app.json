{
  "expo": {
    "name": "Domino Social Club",
    "slug": "domino-party",
    "version": "1.0.13",
    "scheme": "dominoparty",
    "orientation": "portrait",
    "icon": "./assets/social-club-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yht.dominoparty",
      "buildNumber": "12",
      "icon": "./assets/social-club-ios-icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "com.yht.dominoparty",
      "versionCode": 26,
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#04130D",
        "foregroundImage": "./assets/social-club-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/social-club-favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/social-club-splash.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#04130D"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Domino Social Club to scan shared game QR codes."
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-asset"
    ],
    "owner": "yunierht",
    "extra": {
      "eas": {
        "projectId": "4ca6648b-ec5a-4b08-b425-519db3c4ebd7"
      }
    }
  }
}
