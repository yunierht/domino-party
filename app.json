{
  "expo": {
    "name": "Domino Social Club",
    "slug": "domino-social-club",
    "version": "1.0.4",
    "scheme": "dominosocialclub",
    "orientation": "portrait",
    "icon": "./assets/social-club-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yht.dominoparty",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yht.dominoparty",
      "versionCode": 8,
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#08090C",
        "foregroundImage": "./assets/social-club-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/social-club-favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/social-club-splash.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#08090C"
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "4ca6648b-ec5a-4b08-b425-519db3c4ebd7"
      }
    },
    "owner": "yunierht"
  }
}
