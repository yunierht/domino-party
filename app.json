{
  "expo": {
    "name": "Domino Online Test",
    "slug": "domino-online-test",
    "version": "0.1.4",
    "scheme": "domino-online-test",
    "orientation": "portrait",
    "icon": "./assets/social-club-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nextcodestudios.dominoonline.test",
      "buildNumber": "2",
      "icon": "./assets/social-club-ios-icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [],
        "NSMicrophoneUsageDescription": "Domino Online Test uses your microphone for a voice call you start or accept.",
        "NSCameraUsageDescription": "Domino Online Test uses your camera for your avatar photo or to scan an invitation.",
        "NSLocalNetworkUsageDescription": "Connect to the Domino Online test server on your Wi-Fi to play and make voice calls.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": false,
          "NSExceptionDomains": {
            "192.168.1.194": {
              "NSIncludesSubdomains": false,
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      },
      "deploymentTarget": "16.4"
    },
    "android": {
      "package": "com.nextcodestudios.dominoonline.test",
      "versionCode": 5,
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#04130D",
        "foregroundImage": "./assets/social-club-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/social-club-favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/social-club-splash.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#04130D"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Domino Social Club to scan shared game QR codes."
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-asset",
      "./plugins/withOnlineLan",
      "./plugins/withOnlineInvitationLinks",
      "expo-notifications",
      "./plugins/withPlayInvitationLinks",
      "./plugins/withInstallInvitationReferrer"
    ],
    "extra": {
      "eas": {
        "projectId": "9d4cdf14-2853-4b0f-86f4-03108c445056"
      }
    },
    "owner": "yunierht"
  }
}
