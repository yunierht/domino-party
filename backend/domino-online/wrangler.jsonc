{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "domino-online-local-backend",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "LOCAL_ONLY": "true",
    "NETWORK_MODE": "lan",
    "PUBLIC_ORIGIN": "",
    "ALLOWED_WEB_ORIGINS": "[]",
    "TURN_KEY_ID": "",
    "LINKS_HOST": ""
  },
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "DominoRoom"
      },
      {
        "class_name": "ManualCodes",
        "name": "MANUAL_CODES"
      },
      {
        "class_name": "PokerRoom",
        "name": "POKER_ROOMS"
      },
      {
        "class_name": "BlackjackRoom",
        "name": "BLACKJACK_ROOMS"
      },
      {
        "name": "VOICE_BUDGET",
        "class_name": "VoiceBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DominoRoom"
      ]
    },
    {
      "tag": "v2-manual",
      "new_sqlite_classes": [
        "ManualCodes"
      ]
    },
    {
      "tag": "v3-poker",
      "new_sqlite_classes": [
        "PokerRoom"
      ]
    },
    {
      "tag": "v4-blackjack",
      "new_sqlite_classes": [
        "BlackjackRoom"
      ]
    },
    {
      "tag": "v5-voice-budget",
      "new_sqlite_classes": [
        "VoiceBudget"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "ADMISSION_LIMIT",
      "namespace_id": "735217984621",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "../../.release-audit/internet/public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
