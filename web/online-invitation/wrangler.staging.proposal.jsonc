{
  "$schema": "../../backend/domino-online/node_modules/wrangler/config-schema.json",
  "name": "domino-online-links-staging",
  "main": "worker.js",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": false},
  "vars": {"LINKS_HOST": "online-test.dominoparty.com"},
  "routes": [{"pattern": "online-test.dominoparty.com", "custom_domain": true}],
  "assets": {
    "directory": "../../.release-audit/online-links-staging",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  }
}
